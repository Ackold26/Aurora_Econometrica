{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Optimizer MMM",
    "version": "2.4.0",
    "identifier": "com.aurora.econometrica",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://127.0.0.1:5173",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../build"
    },
    "app": {
        "windows": [],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://ackold26.github.io http://localhost:7430; frame-src 'none'; object-src 'none'; base-uri 'self'"
        }
    },
    "plugins": {},
    "bundle": {
        "active": true,
        "targets": [
            "nsis"
        ],
        "publisher": "A. Sipovich",
        "copyright": "© 2026 A. Sipovich",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": [
            "help-econometrica/*",
            "../sidecar/econometrica/**/*",
            "../content-packs/*",
            "sidecar/pptx_pipeline.py",
            "../NOTICE.md"
        ],
        "windows": {
            "nsis": {
                "installMode": "perMachine",
                "installerHooks": "./installer_hooks.nsh"
            }
        }
    }
}