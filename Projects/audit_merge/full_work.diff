+/// приписка нужна ему всегда, потому и живёт отдельным полем.
+fn build_cancelled_event(text: &str, notice: &str) -> String {
+    serde_json::json!({
+        "type": "assistant",
+        "message": { "content": [ { "type": "text", "text": text } ] },
+        "cancelled_run": true,
+        "notice": notice,
