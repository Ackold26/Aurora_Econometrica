+/// до АК») — в отчёте это многострочные ячейки и рваный текст. Схлопывает любой
+/// whitespace (вкл. переводы строк) в один пробел, обрезает края.
+fn clean_label(s: &str) -> String {
+    s.split_whitespace().collect::<Vec<_>>().join(" ")
+}
