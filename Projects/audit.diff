@@ -205,3 +205,65 @@ def test_слайд_различает_три_состояния_заверен
     неполное = dict(строки_сертификата(_сертификат(
         status='not_attested', reproducibility={'status': 'absent'})))
     assert неполное['Заверение'] == 'неполное'
+
+
+# ── 8. Находки аудита ПОЧИНКИ (2026-08-03) ───────────────────────────────────
+
+def test_вердикты_базы_говорят_об_одной_и_той_же_величине():
+    """🔴 Ф-02. Все три вердикта присваиваются по вероятности того, что СРЕДНИЙ
+    по периодам базовый уровень отрицателен. Из «пройдено» по-периодные
+    утверждения убрали, а в соседних они оставались слово в слово — включая
+    «вклад каналов завышен», ту самую фразу, которую вычистили."""
+    for состояние in ('watch', 'failed'):
+        вывод = _render_certificate_block({'certificate': _сертификат(
+            checks={'negative_baseline': состояние})})
+        assert 'на части периода' not in вывод, состояние
+        assert 'вклад каналов завышен' not in вывод, состояние
+        assert 'Средний базовый уровень' in вывод, состояние
+
+
+def test_подвал_печатается_только_вместе_с_отпечатком():
+    """🔴 Ф-06. Оговорка «Отпечаток покрывает файл модели» печаталась и на
+    отказе, где отпечатка клиенту не выдали, да ещё рядом с пустым списком."""
+    отказ = _render_certificate_block({'certificate': {
+        'status': 'unavailable', 'reason': 'Заверять нечего.', 'hash': None,
+        'reproducibility': {'status': 'absent'},
+        'checks': {'negative_baseline': 'absent'},
+    }})
+    assert 'Заверение недоступно' in отказ
+    assert 'Отпечаток покрывает' not in отказ
+    assert 'до выноса' not in отказ
+    assert '<ul' not in отказ, 'пустой список в разметке'
+
