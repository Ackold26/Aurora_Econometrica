+    name, spend: 100_000_000, contribution, contribution_pct: pct, share_of_effect: pct,
+    share_of_spend: pct, efficiency_gap: 0, roi: 1.2, category: 'mixed',
+    verdict: 'Эффективен', verdict_tone: 'good',
