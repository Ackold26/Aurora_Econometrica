+    channels: [
+      ch('Канал A', 875_000_000, 87.5),
+      ch('Канал B', 75_000_000, 7.5),
+      ch('Канал C', 50_000_000, 5.0),
+    ],
+    waterfall: {
+      labels: ['База', 'Канал A', 'Канал B', 'Канал C', 'Итого'],
+      values: [700_000_000, 875_000_000, 75_000_000, 50_000_000, 1_700_000_000],
