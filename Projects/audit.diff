@@ -0,0 +1,450 @@
+//! Core-крейт: общий SSH-транспорт тонких клиентов Aurora; перенос боевого
+//! эталона thin-client/app.
+//!
+//! Транспортный модуль Aurora тонкого клиента.
+//!
+//! Ответственность: отправить JSON-запрос на gateway-узел через SSH
+//! и вернуть распарсенный JSON-ответ. Всё остальное — не наша задача.
+//!
+//! ## Транспортный контракт
+//! Канал: системный `ssh` (OpenSSH). На Windows — System32\OpenSSH\ssh.exe.
+//! Аутентификация клиента: user-сертификат (`client_key` + `client_key-cert.pub`).
+//! Доверие серверу: host-CA в `known_hosts` (`@cert-authority`), никакого TOFU.
+//! Обмен: строго JSON в stdin → JSON в stdout. Ни shell, ни ФС сервера недоступны
+//! (forced-command на сервере).
+//!
+//! ## Размещение ключей клиента
+//! По умолчанию `%APPDATA%\Aurora\client\` (Windows) или `~/.aurora-thin/` (POSIX).
+//! Набор файлов: `client_key` (приватный ключ), `client_key-cert.pub` (сертификат),
+//! `known_hosts` (CA-запись сервера). Выдаётся через `issue_client.sh` на сервере.
+//!
+//! ## Почему std::process::Command, не tokio::process
+//! SSH-процесс — это блокирующий I/O с очень предсказуемым временем жизни:
+//! запрос отправлен → ждём ответа. Tokio нужен нам для параллельных задач
+//! Tauri-команд, но SSH-диалог сам по себе последовательный. Используем
+//! `tokio::task::spawn_blocking` чтобы не блокировать рантайм.
+
+use serde::{Deserialize, Serialize};
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::io::{Read, Write};
+use thiserror::Error;
+
+// ── Типы ────────────────────────────────────────────────────────────────────
+
+/// Запрос к gateway. Поля совпадают с контрактом сервера (aurora-thin.sh).
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct GatewayRequest {
+    /// Идентификатор кабинета (например "legal", "analyst").
+    pub cabinet: String,
+    /// Промпт пользователя — произвольный текст, не интерполируется в shell.
+    pub prompt: String,
+    /// Метка сессии для логирования на сервере (не секрет).
+    pub session_key: String,
+}
+
+/// Ответ от gateway. Сервер всегда возвращает JSON с полями ниже.
+#[derive(Debug, Clone, Deserialize, Serialize)]
+pub struct GatewayResponse {
+    /// "ok" при успехе, "error" при сбое на стороне сервера.
+    pub status: String,
+    /// Текстовый ответ кабинета (при status="ok").
+    #[serde(default)]
+    pub text: Option<String>,
+    /// Вложения-файлы если кабинет вернул артефакты (base64 или URL).
+    #[serde(default)]
+    pub files: Option<Vec<String>>,
+    /// Время выполнения запроса на сервере, СЕКУНДЫ (float — движок отдаёт
+    /// round(elapsed, 1), напр. 2.9). Тип f64 обязателен: u64 уронил бы парсинг
+    /// реального ответа сервера (проверено боем — сервер возвращает "elapsed": 2.9).
+    #[serde(default)]
+    pub elapsed: Option<f64>,
+    /// Сообщение об ошибке (при status="error").
+    #[serde(default)]
+    pub error: Option<String>,
+}
+
+/// Ошибки транспортного уровня.
+#[derive(Debug, Error)]
+pub enum TransportError {
+    /// Один или несколько файлов клиентского пакета отсутствуют/нечитаемы.
+    #[error("Файл клиентского пакета не найден: {path}")]
+    MissingClientFile { path: PathBuf },
+
+    /// Процесс ssh завершился с ненулевым кодом.
+    #[error("SSH завершился с кодом {code}: {stderr}")]
+    SshExitError { code: i32, stderr: String },
+
+    /// Сигнал завершил SSH-процесс (kill, OOM и т.п.).
+    #[error("SSH-процесс прерван сигналом")]
+    SshKilled,
+
+    /// Не удалось запустить процесс ssh (не найден, нет прав).
+    #[error("Не удалось запустить ssh: {0}")]
+    SpawnFailed(#[from] std::io::Error),
+
+    /// Ошибка сериализации JSON-запроса.
+    #[error("Ошибка сериализации запроса: {0}")]
+    SerializeRequest(serde_json::Error),
+
+    /// Ответ сервера не является валидным JSON.
+    #[error("Ответ сервера не является JSON: {raw}")]
+    InvalidJson { raw: String },
+
+    /// Ошибка записи stdin в SSH-процесс.
+    #[error("Не удалось записать запрос в stdin SSH: {0}")]
+    StdinWrite(std::io::Error),
+
+    /// SSH вернул пустой stdout — это не ожидаемое поведение gateway.
+    #[error("Пустой ответ от gateway (ssh вернул пустой stdout)")]
+    EmptyResponse,
+
+    /// Ответ сервера превысил допустимый размер (защита от OOM при баге сервера).
+    #[error("Ответ сервера превысил лимит {limit} байт")]
+    ResponseTooLarge { limit: usize },
+}
+
+/// Потолок размера ответа gateway (защита от OOM). Ответы кабинетов — текст,
+/// реальный размер килобайты; 16 МБ с огромным запасом, но не «бесконечность».
+const MAX_RESPONSE_BYTES: usize = 16 * 1024 * 1024;
+
+// ── Константы ───────────────────────────────────────────────────────────────
+
+/// Пользователь SSH-соединения на gateway. Задан forced-command на сервере.
+const SSH_USER: &str = "aurora-client";
+
+/// Имена файлов в директории клиентского пакета.
+const FILE_KEY: &str = "client_key";
+const FILE_CERT: &str = "client_key-cert.pub";
+const FILE_KH: &str = "known_hosts";
+
+// ── Определение пути к ssh ───────────────────────────────────────────────────
+
+/// Возвращает путь к ssh-бинарю.
+///
+/// На Windows используем System32\OpenSSH\ssh.exe — встроенный OpenSSH.
+/// Git-Bash-овский ssh не поддерживает нужный формат CertificateFile в
+/// сочетании с known_hosts @cert-authority (проверено боем в aurora-thin.sh).
+/// На POSIX-системах — просто "ssh" из PATH.
+fn ssh_binary() -> PathBuf {
+    #[cfg(target_os = "windows")]
+    {
+        // Канонический путь встроенного OpenSSH на Windows 10/11.
+        let system32 = std::env::var("SystemRoot").unwrap_or_else(|_| "C:\\Windows".to_string());
+        PathBuf::from(format!("{}\\System32\\OpenSSH\\ssh.exe", system32))
+    }
+    #[cfg(not(target_os = "windows"))]
+    {
+        PathBuf::from("ssh")
+    }
+}
+
+// ── Основная функция ─────────────────────────────────────────────────────────
+
+/// Отправить запрос на gateway-узел через SSH и вернуть распарсенный ответ.
+///
+/// # Аргументы
+/// * `node` — IP-адрес или hostname gateway-узла (без порта, SSH порт 22).
+/// * `client_dir` — директория с клиентским пакетом (`client_key`,
+///   `client_key-cert.pub`, `known_hosts`).
+/// * `cabinet` — идентификатор кабинета.
+/// * `prompt` — промпт пользователя.
+/// * `session_key` — метка сессии.
+///
+/// # Безопасность
+/// * Никакой интерполяции пользовательского ввода в shell-строки: промпт
+///   передаётся через stdin как JSON-данные, не как аргументы командной строки.
+/// * `StrictHostKeyChecking=yes` + `UserKnownHostsFile` с @cert-authority —
+///   доверие серверу по CA, MITM-подмена host-ключа отвергается немедленно.
+/// * `IdentitiesOnly=yes` — ssh использует ровно наш ключ+cert, не перебирает
+///   агента (BatchMode=yes блокирует любой интерактивный ввод).
+///
+/// # Блокировка
+/// Функция синхронная; вызывать через `tokio::task::spawn_blocking` из async-контекста.
+pub fn send_to_gateway(
+    node: &str,
+    client_dir: &Path,
+    cabinet: &str,
+    prompt: &str,
+    session_key: &str,
+) -> Result<GatewayResponse, TransportError> {
+    // ── Шаг 1: Проверить наличие клиентского пакета ──────────────────────────
+    let key_path = client_dir.join(FILE_KEY);
+    let cert_path = client_dir.join(FILE_CERT);
+    let kh_path = client_dir.join(FILE_KH);
+
+    for path in [&key_path, &cert_path, &kh_path] {
+        if !path.exists() {
+            return Err(TransportError::MissingClientFile { path: path.clone() });
+        }
+    }
+
+    // ── Шаг 2: Сериализовать запрос в JSON ──────────────────────────────────
+    let req = GatewayRequest {
+        cabinet: cabinet.to_string(),
+        prompt: prompt.to_string(),
+        session_key: session_key.to_string(),
+    };
+    let req_json = serde_json::to_string(&req).map_err(TransportError::SerializeRequest)?;
+
+    // ── Шаг 3: Запустить SSH с нужными опциями ───────────────────────────────
+    // Опции зеркалят aurora-thin.sh (доказано боем):
+    //   -i client_key                     — приватный ключ клиента
+    //   -o CertificateFile=cert.pub       — user-сертификат (подписан CA)
+    //   -o IdentitiesOnly=yes             — ровно наш ключ, без агента
+    //   -o BatchMode=yes                  — без интерактивного ввода
+    //   -o StrictHostKeyChecking=yes      — отвергать неизвестные host-ключи
+    //   -o UserKnownHostsFile=known_hosts — наш known_hosts с @cert-authority
+    let mut child = Command::new(ssh_binary())
+        .arg("-i").arg(&key_path)
+        .arg("-o").arg(format!("CertificateFile={}", cert_path.display()))
+        .arg("-o").arg("IdentitiesOnly=yes")
+        .arg("-o").arg("BatchMode=yes")
+        .arg("-o").arg("StrictHostKeyChecking=yes")
+        .arg("-o").arg(format!("UserKnownHostsFile={}", kh_path.display()))
+        // C-2 (аудит): без таймаутов ssh висит вечно при протухшем NAT/мёртвом сервере,
+        // замораживая поток spawn_blocking. ConnectTimeout — на установку; ServerAlive*
+        // (15с × 4 = 60с) детектит мёртвое соединение НЕ убивая долгую задачу (движок poll
+        // до 30 мин: keepalive идёт на SSH-уровне, пока сервер жив).
+        .arg("-o").arg("ConnectTimeout=10")
+        .arg("-o").arg("ServerAliveInterval=15")
+        .arg("-o").arg("ServerAliveCountMax=4")
+        .arg(format!("{}@{}", SSH_USER, node))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()?;
+
+    // ── Шаг 4: Записать JSON в stdin ─────────────────────────────────────────
+    // printf '%s' "$REQ" в aurora-thin.sh — без завершающего \n на Windows/Linux.
+    // H-4 (аудит): stdin обязателен — при None (не должно быть при Stdio::piped, но defensive)
+    // сервер получил бы EOF без запроса; fail-closed вместо тихого пустого запроса.
+    {
+        let mut stdin = child.stdin.take().ok_or_else(|| {
+            TransportError::StdinWrite(std::io::Error::new(
+                std::io::ErrorKind::BrokenPipe, "stdin SSH-процесса недоступен"))
+        })?;
+        stdin.write_all(req_json.as_bytes()).map_err(TransportError::StdinWrite)?;
+        // stdin закрывается при выходе из блока — сигнализирует EOF серверу.
+    }
+
+    // ── Шаг 5: Читать stdout и stderr ПАРАЛЛЕЛЬНО, затем ждать завершения ──────
+    // R-02 (доработка): читать stdout блокирующим take().read_to_end(), а stderr —
+    // ПОСЛЕ wait() нельзя: если ssh пишет >64 КБ в stderr пока stdout открыт,
+    // дочерний процесс блокируется на записи в заполненный буфер трубы, а мы —
+    // на чтении stdout → взаимоблокировка. Решение: дренируем stderr в отдельном
+    // потоке параллельно с чтением stdout (так же, как делал wait_with_output()).
+    //
+    // Ограничения аллокации на обоих потоках:
+    //   stdout — Read::take(MAX_RESPONSE_BYTES): лишние байты не аллоцируются.
+    //   stderr — Read::take(STDERR_CAP): достаточно для диагностики SSH, не OOM.
+    //
+    // M-5 (аудит): потолок MAX_RESPONSE_BYTES — защита от OOM при баге сервера.
+    // Если прочитано ровно MAX_RESPONSE_BYTES → take() остановил поток → лимит достигнут.
+    const STDERR_CAP: u64 = 64 * 1024; // 64 КБ — достаточно для любого SSH-сообщения об ошибке
+
+    // Запускаем дренирование stderr в отдельном потоке, пока основной читает stdout.
+    let stderr_handle = {
+        let stderr_pipe = child.stderr.take().ok_or_else(|| {
+            TransportError::StdinWrite(std::io::Error::new(
+                std::io::ErrorKind::Other, "stderr SSH-процесса недоступен"))
+        })?;
+        std::thread::spawn(move || {
+            let mut buf = Vec::new();
+            // take() обрезает поток — stderr не может съесть неограниченно RAM.
+            let _ = stderr_pipe.take(STDERR_CAP).read_to_end(&mut buf);
+            buf
+        })
+    };
+
+    // Основной поток: читаем stdout с лимитом аллокации на входе.
+    let stdout_bytes = {
+        let stdout = child.stdout.take().ok_or_else(|| {
+            TransportError::StdinWrite(std::io::Error::new(
+                std::io::ErrorKind::Other, "stdout SSH-процесса недоступен"))
+        })?;
+        let mut buf = Vec::new();
+        stdout.take(MAX_RESPONSE_BYTES as u64).read_to_end(&mut buf)?;
+        buf
+    };
+
+    // stdout исчерпан → дочерний процесс может завершиться. Ждём.
+    let status = child.wait()?;
+
+    // Забираем stderr из потока (он уже завершился к этому моменту, т.к. процесс закрыт).
+    let stderr_bytes = stderr_handle.join().unwrap_or_default();
+
+    // Проверяем лимит stdout: ровно MAX_RESPONSE_BYTES → take() остановил нас.
+    if stdout_bytes.len() == MAX_RESPONSE_BYTES {
+        return Err(TransportError::ResponseTooLarge { limit: MAX_RESPONSE_BYTES });
+    }
+
+    if !status.success() {
+        let stderr = String::from_utf8_lossy(&stderr_bytes).into_owned();
+        if status.code().is_none() {
+            return Err(TransportError::SshKilled);
+        }
+        return Err(TransportError::SshExitError {
+            code: status.code().unwrap_or(-1),
+            stderr,
+        });
+    }
+
+    // ── Шаг 6: Распарсить JSON-ответ ─────────────────────────────────────────
+    let raw = String::from_utf8_lossy(&stdout_bytes).into_owned();
+    if raw.trim().is_empty() {
+        return Err(TransportError::EmptyResponse);
+    }
+
+    serde_json::from_str::<GatewayResponse>(&raw)
+        .map_err(|_| TransportError::InvalidJson { raw })
+}
+
+// ── Юнит-тесты (без реальной сети) ──────────────────────────────────────────
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    // ── Сериализация запроса ─────────────────────────────────────────────────
+
+    #[test]
+    fn request_serializes_all_fields() {
+        let req = GatewayRequest {
+            cabinet: "legal".to_string(),
+            prompt: "Проверь договор".to_string(),
+            session_key: "sess-001".to_string(),
+        };
+        let json = serde_json::to_string(&req).unwrap();
+        assert!(json.contains("\"cabinet\":\"legal\""), "cabinet");
+        assert!(json.contains("\"prompt\":\"Проверь договор\""), "prompt");
+        assert!(json.contains("\"session_key\":\"sess-001\""), "session_key");
+    }
+
+    #[test]
+    fn request_no_extra_fields() {
+        // Запрос должен содержать ровно три поля — не более, не менее.
+        let req = GatewayRequest {
+            cabinet: "x".into(),
+            prompt: "y".into(),
+            session_key: "z".into(),
+        };
+        let val: serde_json::Value = serde_json::to_value(&req).unwrap();
+        let obj = val.as_object().unwrap();
+        assert_eq!(obj.len(), 3, "ровно 3 поля в запросе, получено: {}", obj.len());
+    }
+
+    #[test]
+    fn request_with_unicode_prompt_round_trips() {
+        // Кириллица и спецсимволы не должны ломать JSON.
+        let prompt = "Ставка НДС 20% — «котируется»?";
+        let req = GatewayRequest {
+            cabinet: "analyst".into(),
+            prompt: prompt.into(),
+            session_key: "unicode-test".into(),
+        };
+        let json = serde_json::to_string(&req).unwrap();
+        let back: GatewayRequest = serde_json::from_str(&json).unwrap();
+        assert_eq!(back.prompt, prompt, "промпт с кириллицей должен round-trip без потерь");
+    }
+
+    // ── Десериализация ответа ────────────────────────────────────────────────
+
+    #[test]
+    fn response_ok_full_parses() {
+        let json = r#"{"status":"ok","text":"Анализ завершён","files":null,"elapsed":1234,"error":null}"#;
+        let resp: GatewayResponse = serde_json::from_str(json).unwrap();
+        assert_eq!(resp.status, "ok");
+        assert_eq!(resp.text.as_deref(), Some("Анализ завершён"));
+        assert_eq!(resp.elapsed, Some(1234.0));
+        assert!(resp.error.is_none());
+    }
+
+    #[test]
+    fn response_error_parses() {
+        let json = r#"{"status":"error","error":"кабинет недоступен"}"#;
+        let resp: GatewayResponse = serde_json::from_str(json).unwrap();
+        assert_eq!(resp.status, "error");
+        assert_eq!(resp.error.as_deref(), Some("кабинет недоступен"));
+        assert!(resp.text.is_none());
+    }
+
+    #[test]
+    fn response_missing_optional_fields_parse_as_none() {
+        // Сервер может не вернуть files/elapsed — должны заполниться None по умолчанию.
+        let json = r#"{"status":"ok","text":"привет"}"#;
+        let resp: GatewayResponse = serde_json::from_str(json).unwrap();
+        assert_eq!(resp.status, "ok");
+        assert!(resp.files.is_none(), "files должен быть None если не пришёл");
+        assert!(resp.elapsed.is_none(), "elapsed должен быть None если не пришёл");
+    }
+
+    #[test]
+    fn response_with_files_parses() {
+        let json = r#"{"status":"ok","text":"готово","files":["data:text/plain;base64,SGVsbG8="],"elapsed":500}"#;
+        let resp: GatewayResponse = serde_json::from_str(json).unwrap();
+        let files = resp.files.unwrap();
+        assert_eq!(files.len(), 1);
+        assert!(files[0].starts_with("data:text/plain"));
+    }
+
+    #[test]
+    fn response_real_server_shape_parses() {
+        // Реальный ответ gateway из боя: status="done", elapsed — FLOAT секунды,
+        // присутствует лишнее поле "turn" (serde должен его игнорировать).
+        let json = r#"{"status": "done", "text": "Ок.", "files": [], "turn": 1, "elapsed": 2.9}"#;
+        let resp: GatewayResponse = serde_json::from_str(json).unwrap();
+        assert_eq!(resp.status, "done");
+        assert_eq!(resp.elapsed, Some(2.9), "elapsed float секунды должен распарситься");
+        assert_eq!(resp.text.as_deref(), Some("Ок."));
+        assert_eq!(resp.files.as_ref().map(|f| f.len()), Some(0));
+    }
+
+    #[test]
+    fn invalid_json_produces_error_variant() {
+        // Не-JSON строка от сервера → транспорт должен вернуть InvalidJson.
+        let raw = "не JSON вообще";
+        let result = serde_json::from_str::<GatewayResponse>(raw);
+        assert!(result.is_err(), "не-JSON должен провалить парсинг");
+    }
+
+    // ── Проверка клиентского пакета ──────────────────────────────────────────
+
+    #[test]
+    fn missing_client_file_detected() {
+        // Директория без файлов → ошибка до запуска SSH.
+        let tmp = std::env::temp_dir().join(format!(
+            "aurora-transport-test-{}",
+            std::process::id()
+        ));
+        let _ = std::fs::remove_dir_all(&tmp);
+        std::fs::create_dir_all(&tmp).unwrap();
+
+        let result = send_to_gateway("127.0.0.1", &tmp, "test", "prompt", "sess");
+        assert!(
+            matches!(result, Err(TransportError::MissingClientFile { .. })),
+            "должна вернуться MissingClientFile, получено: {:?}", result
+        );
+        let _ = std::fs::remove_dir_all(&tmp);
+    }
+
+    // ── SSH-бинарь ───────────────────────────────────────────────────────────
+
+    #[test]
+    #[cfg(target_os = "windows")]
+    fn ssh_binary_windows_points_to_system32() {
+        let bin = ssh_binary();
+        let s = bin.to_string_lossy().to_lowercase();
+        assert!(
+            s.contains("system32\\openssh\\ssh.exe") || s.contains("system32/openssh/ssh.exe"),
+            "на Windows ssh должен указывать на System32\\OpenSSH\\ssh.exe, получено: {}",
+            bin.display()
+        );
+    }
+
+    #[test]
+    #[cfg(not(target_os = "windows"))]
+    fn ssh_binary_posix_is_ssh() {
+        assert_eq!(ssh_binary(), PathBuf::from("ssh"));
+    }
+}
