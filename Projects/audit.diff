+    mp_path.write_text(
+        json.dumps({
+            "n_future_periods": 3,
+            "period_labels": ["2026-10", "2026-11", "2026-12"],
+            "granularity": "month",
+            "future_dates": [],
+            "channels": ["tv_spend"],
+            "warnings": [],
+            "source_hash": "STALEHASH",
+            "confirmed": True,
+        }, ensure_ascii=False),
+        encoding="utf-8",
+    )
+    return mp_path
+
