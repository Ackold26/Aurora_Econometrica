diff --git a/aurora_fleet/src/local_mode.rs b/aurora_fleet/src/local_mode.rs
new file mode 100644
index 0000000..6bb15f8
--- /dev/null
+++ b/aurora_fleet/src/local_mode.rs
@@ -0,0 +1,470 @@
+//! Offline-приоритетная проверка лицензии для локального режима Aurora.
+//!
+//! **Зачем этот модуль:**
+//! Тонкий клиент Aurora поддерживает три режима работы: облачный, гибридный и
+//! «локальный» (on-device модель работает на машине пользователя без SSH-gateway).
+//! В облачном и гибридном режимах каждый запрос проходит через серверный шлюз, и
+//! лицензионный контроль осуществляется на сервере. В **локальном** режиме трафик
+//! обходит сервер целиком, поэтому серверная проверка не срабатывает автоматически.
+//!
+//! Этот модуль закрывает дыру: при старте локального режима клиент **сам**
+//! проверяет лицензию, используя онлайн-приоритет с Ed25519-fallback'ом когда
+//! сервер недоступен. Без этой проверки локальный режим можно было бы использовать
+//! без действующей лицензии, просто отключив сеть.
+//!
+//! **Логика (fail-closed):**
+//! 1. Online-приоритет: спрашиваем сервер через [`online_auth::authorize`].
+//!    - `"ok"` / `"cached"` → разрешаем (сервер подтвердил или кэш свеж).
+//!    - `"blocked"` → **жёсткий отказ** без выхода в offline: сервер явно
+//!      заблокировал лицензию, игнорировать этот сигнал означало бы дыру
+//!      (пользователь может снять кабель и получить доступ через Ed25519).
+//!    - `"offline"` (нет сети, нет кэша) → переходим к п. 2.
+//! 2. Offline Ed25519 fallback: загружаем лицензию и проверяем WMI-binding +
+//!    anti-rollback + expiry + подпись через [`license::License::validate`].
+//! 3. Любой путь, не давший явного `allowed = true`, оставляет `allowed = false`.
+//!    Сомнение = отказ.
+//!
+//! **Гранулярность кабинетов в локальном режиме:**
+//! На текущей фазе: валидная подписанная лицензия + совпавшая машина = локальный
+//! режим разрешён; поле `local_mode_allowed` намеренно НЕ добавляется в структуру
+//! `License` (это сломало бы подписи уже выданных лицензий). Гранулярный запрет
+//! конкретного клиента на локальный режим — это server-side (ответ `"blocked"`).
+
+use chrono::NaiveDate;
+use serde::Serialize;
+use std::path::Path;
+
+use crate::{license::License, online_auth};
+use crate::online_auth::OnlineAuthStatus;
+
+// ── Публичные типы ──────────────────────────────────────────────────────────
+
+/// Источник, из которого получен вердикт о локальном режиме.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+pub enum LocalModeSource {
+    /// Сервер ответил и подтвердил лицензию (status="ok").
+    Online,
+    /// Свежий кэш успешной авторизации (status="cached", сервер недоступен).
+    OnlineCache,
+    /// Сервер недоступен И кэша нет — проверка прошла через Ed25519-подпись.
+    OfflineEd25519,
+    /// Сервер явно заблокировал, или Ed25519 отказал, или лицензия не найдена.
+    Denied,
+}
+
+/// Вердикт проверки лицензии для локального режима.
+///
+/// `allowed = false` при любом сомнении (fail-closed). UI должен показывать
+/// `reason` пользователю и предлагать проверить сеть или лицензию.
+#[derive(Debug, Clone, Serialize)]
+pub struct LocalModeVerdict {
+    /// Разрешён ли локальный режим.
+    pub allowed: bool,
+    /// Список разрешённых кабинетов (пуст при `allowed = false`).
+    pub cabinets: Vec<String>,
+    /// Откуда получен вердикт — для диагностики и логирования.
+    pub source: LocalModeSource,
+    /// Причина отказа для UI, или `None` если `allowed = true`.
+    pub reason: Option<String>,
+}
+
+// ── Внутренний маппинг online-статусов ─────────────────────────────────────
+
+/// Принимает решение на основе ответа online-уровня.
+///
+/// Возвращает `Some(LocalModeVerdict)` если online-уровень дал окончательный
+/// ответ (ok / cached / blocked), и `None` если сеть недоступна и нет кэша
+/// ("offline") — тогда нужно уйти в Ed25519-fallback.
+///
+/// Вынесена в отдельную чистую функцию для юнит-тестирования без сети.
+///
+/// **Важно:** `"blocked"` → `Some(Denied)`, NOT `None`. Выход в offline при
+/// явном серверном запрете был бы дырой: пользователь мог бы снять кабель и
+/// обойти блокировку через Ed25519.
+pub fn decide_from_online(status: &OnlineAuthStatus) -> Option<LocalModeVerdict> {
+    match status.status.as_str() {
+        "ok" => Some(LocalModeVerdict {
+            allowed: true,
+            cabinets: status.cabinets.clone(),
+            source: LocalModeSource::Online,
+            reason: None,
+        }),
+        "cached" => Some(LocalModeVerdict {
+            allowed: true,
+            cabinets: status.cabinets.clone(),
+            source: LocalModeSource::OnlineCache,
+            reason: None,
+        }),
+        "blocked" => {
+            // Сервер явно запретил — не падаем в offline, это дыра.
+            let reason = status
+                .message
+                .clone()
+                .unwrap_or_else(|| "Лицензия заблокирована сервером".to_string());
+            Some(LocalModeVerdict {
+                allowed: false,
+                cabinets: vec![],
+                source: LocalModeSource::Denied,
+                reason: Some(reason),
+            })
+        }
+        // КОНТРАКТ (намеренный): единственный явный серверный запрет — `"blocked"`.
+        // `"offline"` и любой иной/неизвестный статус (в т.ч. `"error"`, `"maintenance"`,
+        // будущие статусы) возвращают None → Ed25519-fallback. Это осознанный выбор:
+        // неизвестный статус = техническая недоступность, а не намеренный запрет.
+        // Ed25519-fallback сам fail-closed: требует валидную подписанную лицензию
+        // с совпадением машины — несанкционированный доступ через него невозможен.
+        // Превращать неизвестные статусы в Denied сломало бы легитимный offline
+        // при временном сбое сервера (например, кратковременный 500 или деплой).
+        _ => None,
+    }
+}
+
+// ── Основная точка входа ────────────────────────────────────────────────────
+
+/// Проверить право на использование локального режима Aurora.
+///
+/// Online-приоритет: сначала проверяем через Supabase-бэкенд; если сервер
+/// недоступен и кэша нет — валидируем Ed25519-лицензию локально. Fail-closed:
+/// любой неопределённый исход возвращает `allowed = false`.
+///
+/// # Аргументы
+/// * `app_config_dir` — директория конфигурации приложения (там живут `license.json`,
+///   `session_cache.json`, `instance.id`).
+/// * `app_version` — версия приложения для онлайн-авторизации.
+/// * `content_version` — версия контент-пакета для онлайн-авторизации.
+/// * `product` — идентификатор продукта для бэкенда (например `"thin-client"`).
+/// * `build_date` — дата сборки приложения; передаётся в `License::validate` для
+///   anti-rollback проверки часов (LI-009).
+pub async fn verify_local_mode(
+    app_config_dir: &Path,
+    app_version: &str,
+    content_version: &str,
+    product: &str,
+    build_date: NaiveDate,
+) -> LocalModeVerdict {
+    // ── Шаг 1: Online-приоритет ─────────────────────────────────────────────
+    let online_status =
+        online_auth::authorize(app_config_dir, app_version, content_version, product).await;
+
+    if let Some(verdict) = decide_from_online(&online_status) {
+        // Сервер дал окончательный ответ (ok / cached / blocked).
+        return verdict;
+    }
+
+    // ── Шаг 2: Offline Ed25519 fallback ────────────────────────────────────
+    // Доходим сюда только если status="offline" (нет сети И нет свежего кэша).
+    // Загружаем и валидируем Ed25519-лицензию: machine binding + anti-rollback
+    // + expiry + подпись.
+    let load_result = License::load(app_config_dir);
+    match load_result {
+        Err(e) => {
+            // Лицензия не найдена или повреждена.
+            LocalModeVerdict {
+                allowed: false,
+                cabinets: vec![],
+                source: LocalModeSource::Denied,
+                reason: Some(e.to_string()),
+            }
+        }
+        Ok(license) => {
+            match license.validate(build_date) {
+                Err(e) => {
+                    // validate() возвращает Err только на не-валидационных ошибках
+                    // (WMI недоступен, некорректный base64 и т.п.).
+                    LocalModeVerdict {
+                        allowed: false,
+                        cabinets: vec![],
+                        source: LocalModeSource::Denied,
+                        reason: Some(e.to_string()),
+                    }
+                }
+                Ok(status) if status.valid => LocalModeVerdict {
+                    allowed: true,
+                    cabinets: status.cabinets,
+                    source: LocalModeSource::OfflineEd25519,
+                    reason: None,
+                },
+                Ok(status) => {
+                    // valid=false — LI-005 (истекла), LI-006 (другая машина),
+                    // LI-007 (неверная подпись), LI-009 (часы откатаны) и т.д.
+                    LocalModeVerdict {
+                        allowed: false,
+                        cabinets: vec![],
+                        source: LocalModeSource::OfflineEd25519,
+                        reason: status.error,
+                    }
+                }
+            }
+        }
+    }
+}
+
+// ── Тесты ───────────────────────────────────────────────────────────────────
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{fingerprint, license::License};
+
+    // ── Вспомогательные конструкторы OnlineAuthStatus ───────────────────────
+
+    fn make_online_status(status: &str, cabinets: Vec<String>, message: Option<String>) -> OnlineAuthStatus {
+        OnlineAuthStatus {
+            available: matches!(status, "ok" | "blocked"),
+            status: status.to_string(),
+            cabinets,
+            content_version: None,
+            app_min_version: "0.0.0".to_string(),
+            expires_at: None,
+            machine_id: "test-machine".to_string(),
+            message,
+            update_required: false,
+            update_url: None,
+            vault_versions: None,
+            content_pack_version: None,
+            content_pack_url: None,
+            content_pack_checksum: None,
+            frontend_version: None,
+            frontend_url: None,
+            frontend_checksum: None,
+        }
+    }
+
+    // ── Тесты LocalModeVerdict: конструирование и сериализация ──────────────
+
+    #[test]
+    fn verdict_allowed_serializes_correctly() {
+        let v = LocalModeVerdict {
+            allowed: true,
+            cabinets: vec!["analyst".into(), "director".into()],
+            source: LocalModeSource::Online,
+            reason: None,
+        };
+        let json = serde_json::to_string(&v).unwrap();
+        // Все поля присутствуют в JSON
+        assert!(json.contains("\"allowed\":true"), "allowed field");
+        assert!(json.contains("\"analyst\""), "cabinets content");
+        assert!(json.contains("\"source\":\"Online\""), "source field");
+        assert!(json.contains("\"reason\":null"), "reason null when allowed");
+    }
+
+    #[test]
+    fn verdict_denied_serializes_correctly() {
+        let v = LocalModeVerdict {
+            allowed: false,
+            cabinets: vec![],
+            source: LocalModeSource::Denied,
+            reason: Some("[LI-005] License has expired".into()),
+        };
+        let json = serde_json::to_string(&v).unwrap();
+        assert!(json.contains("\"allowed\":false"), "allowed=false");
+        assert!(json.contains("\"cabinets\":[]"), "empty cabinets on denial");
+        assert!(json.contains("\"source\":\"Denied\""), "Denied source");
+        assert!(json.contains("LI-005"), "reason contains LI code");
+    }
+
+    #[test]
+    fn all_source_variants_serialize() {
+        for (src, expected) in [
+            (LocalModeSource::Online, "Online"),
+            (LocalModeSource::OnlineCache, "OnlineCache"),
+            (LocalModeSource::OfflineEd25519, "OfflineEd25519"),
+            (LocalModeSource::Denied, "Denied"),
+        ] {
+            let json = serde_json::to_string(&src).unwrap();
+            assert!(
+                json.contains(expected),
+                "variant {expected} missing from serialized form: {json}"
+            );
+        }
+    }
+
+    // ── Тесты маппинга online-статусов ─────────────────────────────────────
+
+    #[test]
+    fn decide_ok_gives_allowed_online() {
+        let status = make_online_status("ok", vec!["analyst".into()], None);
+        let verdict = decide_from_online(&status).expect("ok must give Some");
+        assert!(verdict.allowed, "ok → allowed");
+        assert_eq!(verdict.source, LocalModeSource::Online);
+        assert_eq!(verdict.cabinets, vec!["analyst"]);
+        assert!(verdict.reason.is_none());
+    }
+
+    #[test]
+    fn decide_cached_gives_allowed_onlinecache() {
+        let status = make_online_status("cached", vec!["director".into()], None);
+        let verdict = decide_from_online(&status).expect("cached must give Some");
+        assert!(verdict.allowed, "cached → allowed");
+        assert_eq!(verdict.source, LocalModeSource::OnlineCache);
+        assert_eq!(verdict.cabinets, vec!["director"]);
+    }
+
+    #[test]
+    fn decide_blocked_gives_denied_not_none() {
+        // blocked → жёсткий Denied, НЕ None (иначе упадём в Ed25519 fallback,
+        // что позволит обойти блокировку отключив кабель).
+        let msg = "Лицензия отозвана администратором".to_string();
+        let status = make_online_status("blocked", vec![], Some(msg.clone()));
+        let verdict = decide_from_online(&status).expect("blocked must give Some, not fall through to offline");
+        assert!(!verdict.allowed, "blocked → denied");
+        assert_eq!(verdict.source, LocalModeSource::Denied);
+        assert_eq!(verdict.reason.as_deref(), Some(msg.as_str()));
+        assert!(verdict.cabinets.is_empty());
+    }
+
+    #[test]
+    fn decide_blocked_without_message_uses_default_reason() {
+        let status = make_online_status("blocked", vec![], None);
+        let verdict = decide_from_online(&status).unwrap();
+        assert!(!verdict.allowed);
+        // Дефолтная причина должна быть непустой — UI не должен видеть пустой текст.
+        assert!(
+            verdict.reason.as_deref().unwrap_or("").len() > 0,
+            "default blocked reason must be non-empty"
+        );
+    }
+
+    #[test]
+    fn decide_offline_gives_none() {
+        // "offline" → None, нужно падать в Ed25519 fallback.
+        let status = make_online_status("offline", vec![], None);
+        let result = decide_from_online(&status);
+        assert!(result.is_none(), "offline must return None to trigger Ed25519 fallback");
+    }
+
+    #[test]
+    fn decide_unknown_status_gives_none() {
+        // Неизвестный статус — не trust, не block, уходим в fallback.
+        let status = make_online_status("unknown-future-status", vec![], None);
+        let result = decide_from_online(&status);
+        assert!(result.is_none(), "unknown status must return None (conservative)");
+    }
+
+    /// Регрессионный тест контракта ветки `_ => None` в `decide_from_online`.
+    ///
+    /// Статус `"error"` — технический сбой на сервере, НЕ намеренный запрет.
+    /// Контракт: `decide_from_online` возвращает `None` → уход в Ed25519-fallback,
+    /// который сам fail-closed (требует валидную подписанную лицензию + совпадение машины).
+    /// Превращение `"error"` в `Denied` сломало бы легитимный offline при кратковременном
+    /// сбое сервера (500, деплой и т.п.).
+    #[test]
+    fn decide_error_status_gives_none_not_denied() {
+        let status = make_online_status("error", vec![], None);
+        let result = decide_from_online(&status);
+        assert!(
+            result.is_none(),
+            "status='error' must return None (техническая недоступность → Ed25519-fallback)"
+        );
+    }
+
+    /// Аналогично: `"maintenance"` — плановое техническое окно, не блокировка.
+    /// Пользователь с валидной лицензией должен продолжать работать offline.
+    #[test]
+    fn decide_maintenance_status_gives_none_not_denied() {
+        let status = make_online_status("maintenance", vec![], None);
+        let result = decide_from_online(&status);
+        assert!(
+            result.is_none(),
+            "status='maintenance' must return None (плановое окно → Ed25519-fallback)"
+        );
+    }
+
+    // ── Тест fail-closed: denied-вердикт строго соблюдает инвариант ─────────
+
+    #[test]
+    fn denied_verdict_invariant() {
+        // Любой denied-вердикт должен иметь allowed=false и reason=Some.
+        let v = LocalModeVerdict {
+            allowed: false,
+            cabinets: vec![],
+            source: LocalModeSource::Denied,
+            reason: Some("причина".into()),
+        };
+        assert!(!v.allowed, "denied: allowed must be false");
+        assert!(v.reason.is_some(), "denied: reason must be Some");
+        assert!(v.cabinets.is_empty(), "denied: cabinets must be empty");
+    }
+
+    // ── Тест offline-ветки через License::validate_without_rollback_check ───
+
+    /// Проверяет offline-ветку отказа через просроченную лицензию.
+    /// Использует `validate_without_rollback_check` (без anti-rollback),
+    /// чтобы тест не зависел от системного времени.
+    /// Пропускается если WMI недоступен (headless CI).
+    #[test]
+    fn offline_branch_expired_license_is_denied() {
+        // Нам нужен реальный отпечаток машины, чтобы пройти machine-binding check
+        // и добраться до проверки expiry (LI-005).
+        let Ok(fp) = fingerprint::get_machine_fingerprint() else {
+            // WMI недоступен — пропускаем.
+            return;
+        };
+        let fp_hash = fingerprint::hash_fingerprint(&fp);
+
+        let expired_license = License {
+            license_id: "R10-TEST-EXPIRED".into(),
+            issued_to: "Test Corp".into(),
+            expires_at: "2020-01-01".into(), // в прошлом
+            machine_fingerprint_hash: fp_hash,
+            cabinets: vec!["analyst".into()],
+            salt: "c2FsdA==".into(),
+            signature: String::new(), // подпись пустая — но expiry проверяется до неё
+        };
+
+        // validate_without_rollback_check: anti-rollback выключен, проверяем только
+        // machine binding + expiry + signature.
+        let status = expired_license
+            .validate_without_rollback_check()
+            .expect("validate returns Ok (not Err) even for invalid licenses");
+
+        assert!(!status.valid, "expired license must be invalid");
+        let err = status.error.unwrap_or_default();
+        assert!(
+            err.contains("LI-005"),
+            "expected LI-005 (expired), got: {err}"
+        );
+
+        // Эмулируем вердикт offline-ветки как это делает verify_local_mode.
+        let verdict = LocalModeVerdict {
+            allowed: false,
+            cabinets: vec![],
+            source: LocalModeSource::OfflineEd25519,
+            reason: Some(err),
+        };
+        assert!(!verdict.allowed, "fail-closed: expired offline license → denied");
+        assert_eq!(verdict.source, LocalModeSource::OfflineEd25519);
+        assert!(verdict.reason.is_some());
+    }
+
+    /// Проверяет offline-ветку: отсутствие license.json → вердикт Denied с LI-001.
+    #[test]
+    fn offline_branch_missing_license_is_denied() {
+        let tmp = std::env::temp_dir().join(format!(
+            "aurora-local-mode-test-{}",
+            std::process::id()
+        ));
+        let _ = std::fs::remove_dir_all(&tmp);
+        std::fs::create_dir_all(&tmp).unwrap();
+
+        // License::load на пустой директории → LI-001.
+        let err = License::load(&tmp).unwrap_err();
+        assert!(
+            err.to_string().contains("LI-001"),
+            "missing license should surface LI-001, got: {err}"
+        );
+
+        // verify_local_mode превратит это в Denied.
+        let verdict = LocalModeVerdict {
+            allowed: false,
+            cabinets: vec![],
+            source: LocalModeSource::Denied,
+            reason: Some(err.to_string()),
+        };
+        assert!(!verdict.allowed);
+        assert!(verdict.reason.as_deref().unwrap().contains("LI-001"));
+
+        let _ = std::fs::remove_dir_all(&tmp);
+    }
+}
