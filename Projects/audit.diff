diff --git a/sidecar/econometrica/tests/test_decomposer_exposes_breakeven_flag.py b/sidecar/econometrica/tests/test_decomposer_exposes_breakeven_flag.py
new file mode 100644
index 0000000..bb64964
--- /dev/null
+++ b/sidecar/econometrica/tests/test_decomposer_exposes_breakeven_flag.py
@@ -0,0 +1,71 @@
+"""Движок обязан ОТДАВАТЬ признак отключённых порогов окупаемости.
+
+Инцидент, ради которого заведён (2026-08-02): признак `money_roi_unavailable`
+жил только внутри Python — его считал `decomposer` и передавал в
+`channel_action`, где абсолютные breakeven-пороги (шаги 4, 6, 7, 8) не
+применяются. Во фронт он не выходил, и экран показывал вердикты как обычно:
+пользователь не мог знать, что сравнения с точкой безубыточности за ними нет.
+
+Вычислять то же самое на фронте нельзя — это второй источник истины, он
+разойдётся (так ломались ярусы MQS: слой представления держал свою копию
+порогов). Поэтому поле обязано присутствовать в ответе decompose.
+
+Проверка идёт по исходнику: полный `decompose_contributions` требует обученной
+модели, а защитить надо ровно от удаления ключа из ответа. Тот же приём, что у
+`test_mqs_tier_rust_single_source` для Rust-зеркала.
+"""
+import os
+import re
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+_DECOMPOSER = os.path.join(os.path.dirname(_HERE), "engines", "decomposer.py")
+
+
+def _source():
+    assert os.path.isfile(_DECOMPOSER), (
+        f"Не найден {_DECOMPOSER} — путь сместился, почини тест, не отключай"
+    )
+    with open(_DECOMPOSER, encoding="utf-8") as f:
+        return f.read()
+
+
+def test_result_carries_breakeven_flag():
+    """Ключ есть в ответе decompose."""
+    assert "'money_roi_unavailable':" in _source(), (
+        "Признак отключённых порогов пропал из ответа decompose — экран снова "
+        "будет молчать о том, что вердикты не сравниваются с безубыточностью"
+    )
+
+
+def test_flag_is_computed_not_hardcoded():
+    """Значение выводится из состояния расчёта, а не прибито константой.
+
+    Прибитый False вернул бы молчание, прибитый True — ложное предупреждение на
+    исправных проектах; и то и другое зелёно проходит проверку «ключ есть».
+    """
+    src = _source()
+    m = re.search(r"'money_roi_unavailable':\s*(.{0,200})", src, re.DOTALL)
+    assert m, "ключ найден, но значение не разобрать"
+    value = m.group(1)
+    assert "_insight_money_roi_na" in value, (
+        "признак больше не опирается на посчитанный флаг — проверьте, не прибит "
+        f"ли он константой: {value[:120]!r}"
+    )
+    assert not re.match(r"\s*(True|False)\s*,", value), (
+        "признак прибит константой — он обязан отражать реальное состояние расчёта"
+    )
+
+
+def test_effectiveness_mode_counted_as_no_breakeven():
+    """Режим эффективности тоже означает отсутствие денежных порогов.
+
+    Докстринг `channel_action` обещает, что этот случай приходит тем же
+    признаком, — фактически вызывающий передаёт только счётный-без-стоимости.
+    В ответе оба случая сведены сознательно: для пользователя разницы нет.
+    """
+    src = _source()
+    m = re.search(r"'money_roi_unavailable':\s*(.{0,200})", src, re.DOTALL)
+    assert m and "effectiveness" in m.group(1), (
+        "режим эффективности выпал из признака — в нём абсолютных денежных "
+        "порогов тоже нет, а экран об этом промолчит"
+    )
diff --git a/src/lib/__tests__/breakeven-disabled-disclosure.guard.test.js b/src/lib/__tests__/breakeven-disabled-disclosure.guard.test.js
new file mode 100644
index 0000000..1489912
--- /dev/null
+++ b/src/lib/__tests__/breakeven-disabled-disclosure.guard.test.js
@@ -0,0 +1,69 @@
+/**
+ * Сторож: когда пороги окупаемости отключены, экран говорит об этом прямо.
+ *
+ * ЗАЧЕМ. Движок честно отключает абсолютные пороги, когда денежного отношения
+ * нет (`engines/channel_action.py`: «При money_roi_unavailable=True абсолютные
+ * breakeven-пороги (шаги 4, 6, 7, 8) НЕ применяются»). Но признак жил ТОЛЬКО
+ * внутри Python и во фронт не отдавался — экран показывал вердикты как обычно,
+ * и пользователь не мог знать, что сравнения с точкой безубыточности за ними
+ * нет. Молчание здесь хуже отсутствия функции: человек читает вердикт как
+ * абсолютный, а он относительный.
+ *
+ * Признак приходит из движка (`decomposer.py` → `money_roi_unavailable`).
+ * Вычислять его на фронте нельзя: это второй источник истины, и он разойдётся —
+ * ровно так ломались ярусы MQS.
+ */
+import { describe, expect, it } from 'vitest';
+
+import { decomposeInsights } from '../insights-rules.js';
+
+/** Минимальный ответ декомпозиции. @param {Record<string, any>} extra */
+const payload = (extra) => ({
+  channels: [],
+  baseline_pct: 60,
+  total_sales: 1000,
+  ...extra,
+});
+
+const texts = (/** @type {Record<string, any>} */ data) =>
+  decomposeInsights(/** @type {any} */ (data))
+    .map((/** @type {{text: string, tip?: string}} */ i) => `${i.text} ${i.tip ?? ''}`)
+    .join('\n');
+
+describe('признак отключённых порогов доезжает до пользователя', () => {
+  it('при отключённых порогах сообщение показано', () => {
+    const blob = texts(payload({ money_roi_unavailable: true }));
+    expect(blob).toContain('пороги окупаемости отключены');
+  });
+
+  it('сообщение объясняет, на что опираются вердикты вместо порогов', () => {
+    const blob = texts(payload({ money_roi_unavailable: true }));
+    expect(blob).toContain('относительную эффективность');
+  });
+
+  it('сообщение подсказывает, как получить абсолютную оценку', () => {
+    const blob = texts(payload({ money_roi_unavailable: true }));
+    expect(blob).toContain('ценность единицы');
+  });
+
+  it('при работающих порогах сообщения нет — лишний шум недопустим', () => {
+    expect(texts(payload({ money_roi_unavailable: false }))).not.toContain(
+      'пороги окупаемости отключены',
+    );
+  });
+
+  it('старые ответы без поля молчат так же, как раньше', () => {
+    // Признак появился 2026-08-02; результаты, посчитанные до него, поля не
+    // имеют. Показать им сообщение значило бы соврать: пороги там работали.
+    expect(texts(payload({}))).not.toContain('пороги окупаемости отключены');
+  });
+
+  it('строковое «true» из старых артефактов за признак не принимается', () => {
+    // Сравнение строгое (=== true): иначе любое непустое значение включало бы
+    // сообщение, а поле приходит из JSON, где типы уже путались (см. историю
+    // ярлыка mqs_tier_label).
+    expect(texts(payload({ money_roi_unavailable: 'true' }))).not.toContain(
+      'пороги окупаемости отключены',
+    );
+  });
+});
diff --git a/src/lib/__tests__/goalseek-corridor-honesty.guard.test.js b/src/lib/__tests__/goalseek-corridor-honesty.guard.test.js
new file mode 100644
index 0000000..5761371
--- /dev/null
+++ b/src/lib/__tests__/goalseek-corridor-honesty.guard.test.js
@@ -0,0 +1,55 @@
+/**
+ * Сторож честности «зелёной зоны» в расчёте от цели.
+ *
+ * ЗАЧЕМ. Экран обещал: «Цель должна быть в зелёной зоне коридора – иначе модель
+ * экстраполирует за пределы observed range». Обещание не выполнялось: движок
+ * коридор ПРОДАЖ не считает вовсе — `optimize/bounds.py::compute_safe_corridor`
+ * возвращает `per_channel` и `aggregate_budget`, а `aggregate_sales` живёт
+ * ТОЛЬКО в докстринге с пометкой «placeholder, требует forward pass»; в коде его
+ * нет, в `goal_seek.py` тоже. Экран падал на запасной ориентир
+ * `текущие продажи ×0,7…×1,5`, который наблюдавшимся диапазоном не является, —
+ * и клиент принимал решение по обещанию, которого продукт не выполняет.
+ *
+ * Настоящий расчёт вынесен в P1 (общий прямой проход с профит-фронтиром).
+ * До тех пор текст обязан ВЕТВИТЬСЯ: правда про наблюдения — только когда
+ * коридор реально пришёл.
+ *
+ * Проверяется по исходнику: поведение здесь — это текст, который увидит
+ * пользователь, а он собирается в разметке компонента.
+ */
+import { describe, expect, it } from 'vitest';
+
+// Исходник берём импортом `?raw`, а не через fs: под vitest `import.meta.url`
+// приходит не файловой схемой (модули отдаёт dev-сервер), а `process` в этом
+// окружении не типизирован. `?raw` решает оба вопроса и не требует @types/node.
+import src from '../components/pipeline/OptimizeGoalSeek.svelte?raw';
+
+describe('зелёная зона не выдаёт ориентир за наблюдения', () => {
+  it('текст ветвится по признаку настоящего коридора', () => {
+    expect(src).toContain('corridorIsObserved');
+  });
+
+  it('признак выводится из пришедших границ, а не из константы', () => {
+    expect(src).toMatch(/corridorIsObserved\s*=\s*\$derived\([\s\S]{0,200}salesCorridor/);
+  });
+
+  it('запасная ветка честно называет зону ориентиром от текущего уровня', () => {
+    expect(src).toContain('ориентир от текущего уровня');
+  });
+
+  it('обещание про наблюдения не стоит безусловно', () => {
+    // Прежняя формулировка утверждала это всегда — независимо от того, пришёл
+    // коридор или нет. Возврат к ней красит тест.
+    expect(src).not.toContain('иначе модель экстраполирует за пределы observed range');
+  });
+
+  it('в клиентском тексте нет англицизма observed range', () => {
+    // Правило клиентского текста продукта: русский без англицизмов там, где есть
+    // аналог. «observed range» → «наблюдавшийся в данных диапазон».
+    const clientText = src
+      .split('\n')
+      .filter((/** @type {string} */ l) => !l.trim().startsWith('*') && !l.trim().startsWith('//'))
+      .join('\n');
+    expect(clientText).not.toContain('observed range');
+  });
+});
diff --git a/src/lib/__tests__/tier2-roi-base.guard.test.js b/src/lib/__tests__/tier2-roi-base.guard.test.js
new file mode 100644
index 0000000..a4582ed
--- /dev/null
+++ b/src/lib/__tests__/tier2-roi-base.guard.test.js
@@ -0,0 +1,132 @@
+/**
+ * Сторож базы окупаемости в словах советника.
+ *
+ * ЗАЧЕМ. Расчёт продукта корректен в обоих режимах: «Выручка» и «Прибыль» —
+ * полноценные метрики (`utils/kpi_registry.py`), а когда экономика не задана,
+ * абсолютные пороги окупаемости честно отключаются
+ * (`engines/channel_action.py`, ветка `money_roi_unavailable`). Неточной была
+ * РЕЧЬ: правило 7 советника до 2026-08-02 говорило «прибылен канал или
+ * убыточен» безотносительно выбранной метрики. В режиме выручки ROI=1 — это
+ * окупаемость по обороту, из которой прибыльность не следует: себестоимость в
+ * выручке не вычтена. Клиент читал вывод о прибыли там, где модель считала
+ * оборот.
+ *
+ * Тест держит границу поведением: база выводится единственной функцией, доезжает
+ * в факты и названа в правилах. Возврат к безусловной формулировке красит тест.
+ */
+import { describe, expect, it } from 'vitest';
+
+import { roiBase, roiBaseNote } from '../kpi-aware-formatting.js';
+import { buildTier2Context, STEP, TIER2_SYSTEM_RULES } from '../tier2-context.js';
+
+describe('roiBase — база выводится из выбранной метрики', () => {
+  it('режим «Выручка» → оборот', () => {
+    expect(roiBase({ kpiType: 'sales', kpiKind: 'monetary' })).toBe('оборот');
+  });
+
+  it('устаревший ключ revenue → тоже оборот', () => {
+    // Старые проекты сохраняли kpi_type='revenue' (дубликат убран из выбора
+    // в v2.1.0, но в сохранённых проектах остался) — они не должны провалиться
+    // в «не определена» и потерять слова про окупаемость.
+    expect(roiBase({ kpiType: 'revenue', kpiKind: 'monetary' })).toBe('оборот');
+  });
+
+  it('денежный проект без паспорта KPI (legacy) → оборот, а не «не определена»', () => {
+    // У старых проектов kpiType нет вовсе, а ROI исторически считался от продаж
+    // в рублях. Уронить их в «не определена» значило бы отобрать слова про
+    // окупаемость без причины — регресс там, где ошибки не было.
+    expect(roiBase({ kpiKind: 'monetary', kpiType: null })).toBe('оборот');
+  });
+
+  it('режим «Прибыль» → прибыль', () => {
+    expect(roiBase({ kpiType: 'profit', kpiKind: 'monetary' })).toBe('прибыль');
+  });
+
+  it('счётный режим с маржой на единицу → прибыль', () => {
+    expect(roiBase({ kpiType: 'sales_packs', kpiKind: 'count', vpcu: 42 })).toBe('прибыль');
+  });
+
+  it('счётный режим без маржи → база не определена (пороги в движке отключены)', () => {
+    expect(roiBase({ kpiType: 'leads', kpiKind: 'count' })).toBe('не определена');
+    expect(roiBase({ kpiType: 'leads', kpiKind: 'count', vpcu: 0 })).toBe('не определена');
+  });
+
+  it('режим эффективности считает доли, а не деньги → базы нет', () => {
+    expect(roiBase({ kpiKind: 'monetary', kpiType: 'sales', mode: 'effectiveness' })).toBe(
+      'не определена',
+    );
+  });
+
+  it('ничего не известно → база не определена', () => {
+    expect(roiBase({})).toBe('не определена');
+    expect(roiBase(null)).toBe('не определена');
+    expect(roiBase({ kpiType: 'share_of_market', kpiKind: 'proportional' })).toBe(
+      'не определена',
+    );
+  });
+});
+
+describe('roiBaseNote — пояснение соответствует базе', () => {
+  it('при обороте прямо предупреждает, что прибыльность не следует', () => {
+    const note = roiBaseNote({ kpiType: 'sales', kpiKind: 'monetary' });
+    expect(note).toContain('по обороту');
+    expect(note).toContain('не следует');
+  });
+
+  it('при прибыли говорит о прибыли и не путает базы', () => {
+    const note = roiBaseNote({ kpiType: 'profit', kpiKind: 'monetary' });
+    expect(note).toContain('по прибыли');
+    expect(note).not.toContain('по обороту');
+  });
+
+  it('без экономики честно называет пороги отключёнными', () => {
+    const note = roiBaseNote({ kpiType: 'leads', kpiKind: 'count' });
+    expect(note).toContain('отключены');
+  });
+});
+
+describe('база доезжает в факты советника', () => {
+  /** @param {Record<string, any>} [extra] */
+  const call = (extra) =>
+    buildTier2Context({
+      step: STEP.DECOMPOSE,
+      question: 'Какие каналы окупаются?',
+      dec: { channels: [] },
+      ...extra,
+    });
+
+  it('поле roi_base есть в фактах при режиме выручки', () => {
+    expect(call({ kpiType: 'sales', kpiKind: 'monetary' }).facts.roi_base).toBe('оборот');
+  });
+
+  it('поле roi_base есть в фактах при режиме прибыли', () => {
+    expect(call({ kpiType: 'profit', kpiKind: 'monetary' }).facts.roi_base).toBe('прибыль');
+  });
+
+  it('без переданной метрики поле присутствует и честно говорит «не определена»', () => {
+    // Поле обязано быть всегда: отсутствие ключа советник трактовал бы как
+    // «спрашивать не о чем» и вернулся бы к вольной формулировке.
+    expect(call({}).facts.roi_base).toBe('не определена');
+  });
+});
+
+describe('правило 7 называет базу, а не судит о прибыли безусловно', () => {
+  // TIER2_SYSTEM_RULES экспортируется уже склеенной строкой, не массивом.
+  const rules = TIER2_SYSTEM_RULES;
+
+  it('правила ссылаются на поле roi_base', () => {
+    expect(rules).toContain('roi_base');
+  });
+
+  it('безусловной формулировки «прибылен канал или убыточен» больше нет', () => {
+    expect(rules).not.toContain('прибылен канал или убыточен');
+  });
+
+  it('при базе «оборот» слова о прибыли прямо запрещены', () => {
+    expect(rules).toMatch(/оборот[\s\S]{0,400}НЕЛЬЗЯ/);
+  });
+
+  it('при неопределённой базе запрещено и слово «окупается»', () => {
+    expect(rules).toMatch(/не определена[\s\S]{0,400}не используй/);
+  });
+});
