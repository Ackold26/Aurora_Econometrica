+        assert_eq!(
+            matching.len(),
+            N,
+            "ожидали {N} целых строк, получили {}: {:?}",
+            matching.len(),
+            matching
+        );
+        for line in &matching {
+            let cols: Vec<&str> = line.split('\t').collect();
+            assert_eq!(cols.len(), 4, "строка развалилась/слиплась: {line:?}");
+        }
+    }
+}
