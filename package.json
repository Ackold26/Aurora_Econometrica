{
  "name": "aurora-ai-agency",
  "version": "2.4.3",
  "description": "",
  "type": "module",
  "scripts": {
    "build:tokens": "node tools/build-tokens.mjs",
    "build:tokens:check": "node tools/build-tokens.mjs --check",
    "predev": "npm run build:tokens",
    "prebuild": "npm run build:tokens",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build:local": "tauri build --config src-tauri/tauri.local.conf.json -- --no-default-features",
    "tauri:build:thin": "node tools/build-cloud.mjs",
    "check:manifest": "node tools/check-manifest-clean.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:xss": "node tools/lint-xss.mjs",
    "prepare": "lefthook install || true"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.3.3",
    "echarts": "^5.6.0",
    "lucide-svelte": "^1.0.1",
    "marked": "^17.0.5",
    "svelte-i18n": "^4.0.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "jsdom": "^29.0.1",
    "lefthook": "^1.13.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.2"
  }
}
