-- Снятие поля с личными именами. Последний шаг обезличивания платформы (ADR-062).
--
-- 🔴 ЭТОТ ФАЙЛ НЕ САМОДОСТАТОЧЕН. Шаг, который заполняет коды клиентов, выполнен ВРУЧНУЮ и
-- лежит рядом: `20260907_fill_client_code.sql.ПРИМЕНЕНО_2026-09-06_ВРУЧНУЮ`. Список соответствий
-- «написание имени → код» в git не хранится (имена клиентов туда не попадают) и берётся из
-- расшифровки вне репозитория: `_local_pdn/KODY_KLIENTOV_RASSHIFROVKA.md`.
-- Без этого шага прогон каталога миграций по порядку на чистой базе доходит сюда и падает на
-- собственной проверке ниже: «у 46 строк из 46 нет кода клиента». Найдено внешним аудитом 06.09.
--
-- Применять ТОЛЬКО когда выполнены все три условия:
--   1) код клиента заполнен у всех строк licenses;
--   2) панель выдачи пишет client_code и НЕ шлёт customer (иначе выдача упадёт в тот же миг);
--   3) расшифровка «код → клиент» записана вне git (_local_pdn/KODY_KLIENTOV_RASSHIFROVKA.md).
--
-- 🔴 Проверка и действие СЛИТЫ В ОДНО ВЫРАЖЕНИЕ намеренно. Если бы проверка стояла отдельным
-- запросом перед alter, между ними успела бы появиться строка без кода (панель выдаёт лицензии
-- в любую минуту), и удаление колонки унесло бы имя, которому замены нет. Здесь такое
-- расхождение невозможно, а не маловероятно: исключение внутри блока откатывает и оба alter.
--
-- Отдельной выгрузки «id → customer» перед снятием НЕ делается сознательно. Соответствие
-- написаний кодам уже записано в расшифровке вне git, а выгрузка создала бы ещё одну
-- неконтролируемую копию персональных данных — ровно ту ошибку, которую мера чистки журнала
-- 06.09 уже однажды породила и за которую пришлось отдельно отвечать.
do $mig$
declare
  vsego int;
  bez_koda int;
begin
  select count(*), count(*) filter (where client_code is null)
    into vsego, bez_koda
    from public.licenses;

  if vsego = 0 then
    raise exception 'Снятие отменено: в licenses нет ни одной строки — похоже, смотрим не туда';
  end if;

  if bez_koda > 0 then
    raise exception 'Снятие отменено: у % строк из % нет кода клиента. Сначала заполнить код, потом снимать имя', bez_koda, vsego;
  end if;

  execute 'alter table public.licenses alter column client_code set not null';
  execute 'alter table public.licenses drop column customer';

  raise notice 'Поле customer снято. Строк: %, у всех код клиента на месте.', vsego;
end
$mig$;

comment on column public.licenses.client_code is
  'Код клиента (ADR-062) — единственное, чем лицензия связана с клиентом. Наименований и имён '
  'людей в этой базе больше нет: они живут в российском контуре, а соответствие «код → клиент» '
  'сюда не попадает ни в каком виде, включая подсказки в соседних полях.';
