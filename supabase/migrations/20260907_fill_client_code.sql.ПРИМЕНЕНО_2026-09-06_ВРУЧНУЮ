-- Заполнение кодов клиентов (ADR-062). Шаг между заведением колонки и снятием имени.
--
-- 🔴 ЭТОТ ШАГ БЫЛ ВЫПОЛНЕН ВРУЧНУЮ 06.09.2026, а файл записан задним числом по находке внешнего
-- аудита. Без него цепочка миграций невоспроизводима: `20260908_drop_licenses_customer.sql`
-- требует «код заполнен у всех строк», а заполнять его было нечем — на чистой копии базы цепочка
-- падала бы с `raise exception 'у % строк из % нет кода клиента'`, и восстановление боя из одних
-- миграций стало бы невозможным.
--
-- 🔴 Воспроизвести дословно НЕЛЬЗЯ и не нужно: соответствие «написание имени → код клиента»
-- невыводимо программно и составлялось человеком. Замер 06.09: 4 отпечатка из 12 несли лицензии
-- под разными написаниями (до трёх на один), 5 лицензий из 46 принадлежали отпечаткам без
-- карточки машины. Ниже — форма запроса, которым заполнение было сделано; список соответствий в
-- ней намеренно оставлен пустым, потому что имена клиентов в репозиторий не попадают. При
-- восстановлении на чистой базе список берётся из расшифровки вне git
-- (`_local_pdn/KODY_KLIENTOV_RASSHIFROVKA.md`) и подставляется руками.
--
-- Свойство, ради которого запрос устроен именно так: **замер является УСЛОВИЕМ действия**.
-- Не покрой список соответствий хоть одну строку из licenses — не обновится ни одна. Разнесённые
-- во времени проверка и обновление разошлись бы тем сильнее, чем живее система.
--
-- Фактический результат применения 06.09: строк в разметке 46, не покрыто 0, обновлено 46
-- (КЛ-0001 — 21, КЛ-0002 — 14, КЛ-0003 — 11). Карточки машин: 10 из 10 (7 и 3).

with sootv(staroe, kod) as (
  values
    -- ('<значение customer как в базе>', 'КЛ-0001'),
    -- ...список берётся из расшифровки вне git...
    (null::text, null::text)
),
razmetka as (
  select l.id,
         coalesce(s.kod,
           -- Написание, относящееся сразу к двум организациям, разводится ПО МАШИНЕ, а не по имени:
           -- основанием служит разметка машин владельцем, а не совпадение написаний.
           case when cm.company = 'Платформа Аврора' then 'КЛ-0002'
                when cm.company = 'РОССТ'            then 'КЛ-0001' end
         ) as kod
  from licenses l
  left join sootv s on s.staroe = l.customer
  left join client_machines cm on cm.fingerprint_hash = l.fingerprint_hash
),
proverka as (
  select count(*) as vsego, count(*) filter (where kod is null) as ne_pokryto from razmetka
),
obnovlenie as (
  update licenses l set client_code = r.kod::public.client_code
    from razmetka r, proverka p
   where l.id = r.id and p.ne_pokryto = 0
  returning l.id
)
select (select vsego from proverka)      as strok_v_razmetke,
       (select ne_pokryto from proverka) as ne_pokryto,
       (select count(*) from obnovlenie) as obnovleno;
