-- Правка функции сегодня НЕ сделана сознательно: по CPD-154 исходник функции входа лежит вне
-- канонического каталога, и доказать, что правится именно то, что стоит в бою, дешёвым способом
-- не удалось (замер 06.09 в реестре). Сначала переезд источника — потом правка двери.
--
-- Свёртка без ключа рассматривалась и ОТВЕРГНУТА: пространство адресов IPv4 перебирается за
-- минуты, то есть свёртка обратима и даёт ложное чувство защиты (INV-38).

-- Окно хранения. Подставить значение, согласованное владельцем (90 / 60 / 30).
update public.audit_log
   set details = details - 'client_ip' - 'hostname'
 where created_at < now() - interval '90 days'
   and (details ? 'client_ip' or details ? 'hostname');

