-- Код клиента: связь обезличенной платформы с российским контуром (ADR-062).
-- Решение владельца 06.09: за пределами России остаётся код вида КЛ-0001 БЕЗ смысла внутри кода;
-- таблица соответствия «код → клиент» живёт только в российском контуре. Обезличивание делается
-- сразу с кодом, а не разовой заменой, чтобы не переделывать дважды.
--
-- Что эта запись изменений делает: заводит один домен-правило и добавляет по одной колонке в
-- licenses и client_machines. Ни одной строки НЕ переписывает: колонки создаются пустыми,
-- customer не трогается вовсе. Числа до и после обязаны совпасть (licenses 46, client_machines 10,
-- activations 241, device_bindings 0).
--
-- Чего эта запись изменений сознательно НЕ делает:
--   * не создаёт справочника клиентов в этой базе — источник истины о том, какой код чей,
--     находится в российском контуре; внешний ключ на пустой местный справочник был бы
--     ложной гарантией (отчёт, §3.1 вариант Б);
--   * не удаляет и не переписывает licenses.customer — удаление отдельной, ВТОРОЙ миграцией,
--     после того как панель выдачи научится писать и показывать код (иначе выдача лицензии
--     ломается в тот же миг: панель шлёт поле customer в POST, строка 1091);
--   * не ставит not null — на момент применения кода нет ни у одной строки;
--   * не заводит внешнего ключа из licenses в client_machines: пять лицензий из сорока шести
--     принадлежат отпечаткам без карточки машины (замер 06.09), ключ отменил бы им выдачу.

-- ── 1. Домен «код клиента» ───────────────────────────────────────────────────────────────────
--
-- Проверки разделены намеренно (образец role_email/operator_label): при падении имя ограничения
-- попадает в текст ошибки и сразу видно, что именно не так.
--
-- 🔴 Буквы в префиксе — КИРИЛЛИЧЕСКИЕ. Латинские K и L неотличимы на глаз, а порча кодировки в
-- этой самой колонке уже случалась (CPD-136). Сторож no_latin ловит её отдельным сообщением.
--
-- 🔴 Чего этот домен НЕ ловит и не может: он удерживает ФОРМУ, а не бессмысленность. Код
-- «КЛ-2024» по году основания клиента или «КЛ-0001..0008» в алфавитном порядке имён пройдёт
-- проверку и разрушит обезличивание. Это дисциплина назначения (отчёт, §7), а не тип данных.
do $mig$
begin
  if not exists (
    select 1 from pg_type t join pg_namespace n on n.oid = t.typnamespace
     where t.typname = 'client_code' and n.nspname = 'public'
  ) then
    create domain public.client_code as text
      constraint client_code_len      check (length(value) = 7)
      constraint client_code_shape    check (value ~ '^КЛ-[0-9]{4}$')
      constraint client_code_no_latin check (value !~ '[A-Za-z]');
  end if;
end
$mig$;

comment on domain public.client_code is
  'Код клиента — единственная связь обезличенной платформы с российским контуром (ADR-062). '
  'Форма КЛ-0001, буквы кириллические, номер БЕЗ смысла: не год, не порядок по алфавиту имён, '
  'не инициалы. Соответствие «код → клиент» в этой базе не хранится и храниться не должно. '
  'Проверка удерживает форму, а не бессмысленность: смысловой номер пройдёт и сделает '
  'обезличивание ложным (INV-38 — псевдонимизация есть смягчение, а не основание).';

-- ── 2. Код клиента в строке лицензии ─────────────────────────────────────────────────────────
alter table public.licenses
  add column if not exists client_code public.client_code;

comment on column public.licenses.client_code is
  'Код клиента (ADR-062). Заменяет собой customer, который снимается второй миграцией после '
  'правки панели выдачи. Пусто допустимо только на время перехода.';

-- ── 3. Код клиента в карточке машины ─────────────────────────────────────────────────────────
-- ADR-062: «компания в карточке машины со временем заменяется кодом клиента». Колонка заводится
-- сразу, чтобы у машины и лицензии была ОДНА форма ссылки на клиента; company этой миграцией не
-- удаляется — там сегодня наименования юридических лиц (не персональные данные), и её снятие
-- относится к тому же второму шагу, что и снятие customer.
alter table public.client_machines
  add column if not exists client_code public.client_code;

comment on column public.client_machines.client_code is
  'Код клиента (ADR-062), та же форма, что в licenses.client_code. Со временем заменяет company.';

-- ── 4. Индекс для сводок «по клиенту» ────────────────────────────────────────────────────────
-- Сводка расхода по клиенту сегодня врёт из-за тринадцати написаний на две организации (CPD-136);
-- после ввода кода она станет осмысленной, и группировка пойдёт по этой колонке.
create index if not exists idx_licenses_client_code on public.licenses (client_code);
